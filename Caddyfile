# Front server for PCB Colour-Plan (Caddy).
#
# {$SITE_ADDRESS} comes from the DOMAIN env (docker-compose / .env):
#   - a domain (e.g. pcb.example.com) -> automatic HTTPS via Let's Encrypt
#   - ":80"                           -> plain HTTP, for local testing
#
# To receive Let's Encrypt expiry emails, add `email you@example.com` to the
# global options block below.

# Trust X-Forwarded-For from proxies on private addresses.
#
# On the hosted VM this Caddy sits behind a shared front door on a private
# docker network. Without this setting, Caddy discards the front door's
# X-Forwarded-For, and every visitor reaches the collector carrying the front
# door's IP. That turns the collector's per-client rate limit into one global
# limit, and collapses the unique-visitor count to one per User-Agent.
#
# Nothing else in this file uses the client IP: there is no access control and
# no logging. So the worst a spoofed header from a private address can do is
# skew those two collector counters.
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	root * /srv
	encode zstd gzip

	# Security headers on every response (mirrors the former nginx config).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Long-cache the content-hashed build assets (JS, CSS and the favicon).
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=2592000, immutable"

	# Everything else (index.html, licence notices) is revalidated on every load.
	# The ETag makes that a cheap 304, and a deploy - including a new hashed
	# favicon URL - is picked up immediately instead of after heuristic caching.
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"

	# Opt-in anonymous telemetry -> same-origin collector service. Caddy sets
	# X-Forwarded-For and forwards the User-Agent, so the collector is unchanged.
	handle /collect {
		reverse_proxy collector:8081
	}

	# A missing path that looks like a file (ends in .ext) is a real 404, not the
	# SPA shell. Otherwise /favicon.ico, /robots.txt or a stale /assets/*.js chunk
	# is answered with index.html as text/html and status 200. The app has no
	# client-side routes, so no legitimate navigation is affected.
	@missingFile {
		not file
		path_regexp \.[A-Za-z0-9]+$
	}
	handle @missingFile {
		respond 404
	}

	# Single-page app: serve a matching file, else fall back to index.html.
	handle {
		try_files {path} /index.html
		file_server
	}

	# No `log` directive => Caddy writes no access log => visitor IPs are never
	# logged (privacy; matches the old nginx `access_log off`).
}
